# Modèle — copier en `keystore.properties` (même dossier) et compléter.
# Le vrai fichier est ignoré par git : il contient les mots de passe de la clé
# de signature. Si tu perds cette clé, tu ne pourras PLUS publier de mise à
# jour de l'app sous le même identifiant — sauvegarde le .jks ET ce fichier
# ailleurs qu'ici (gestionnaire de mots de passe, disque externe).

# Chemin vers le keystore, relatif au dossier android/ (ou chemin absolu).
storeFile=trouvetout224-release.jks
storePassword=REMPLACER_PAR_LE_MOT_DE_PASSE_DU_KEYSTORE
keyAlias=trouvetout224
keyPassword=REMPLACER_PAR_LE_MOT_DE_PASSE_DE_LA_CLE
